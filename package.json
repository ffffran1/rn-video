{
  "name": "@ffffran1/rn-video",
  "version": "0.1.0",
  "description": "Reproductor de video para React Native (iOS y Android) con soporte para VOD y transmisiones en vivo (HLS/DASH) y controles 100% personalizables. No requiere Expo.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "react-native",
    "video",
    "player",
    "hls",
    "dash",
    "live",
    "ios",
    "android",
    "vod",
    "streaming",
    "custom-controls",
    "react-native-video"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffffran1/rn-video.git"
  },
  "bugs": {
    "url": "https://github.com/ffffran1/rn-video/issues"
  },
  "homepage": "https://github.com/ffffran1/rn-video#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-video": ">=6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "^19.3.0",
    "react-native": "^0.88.0",
    "react-native-video": "^6.19.3",
    "test-renderer": "^1.3.1",
    "typescript": "~5.9"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|react-native-video)/)"
    ]
  }
}
